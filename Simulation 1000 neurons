import numpy as np
import matplotlib.pyplot as plt

# ==========================================
# 1. CONNECTOME & NETWORK CONFIGURATION
# ==========================================
Ne = 800   # Excitatory Neurons (Cortex)
Ni = 200   # Inhibitory Neurons (Regulation)
N = Ne + Ni

# Random parameters for neuronal diversity (Different firing patterns)
re = np.random.rand(Ne)
ri = np.random.rand(Ni)

# Izhikevich model parameters
# a: recovery time scale | b: sensitivity of the recovery variable
# c: reset voltage       | d: reset of the recovery variable
a = np.hstack((0.02 * np.ones(Ne), 0.02 + 0.08 * ri))
b = np.hstack((0.20 * np.ones(Ne), 0.25 - 0.05 * ri))
c = np.hstack((-65 + 15 * re**2, -65 * np.ones(Ni)))
d = np.hstack((8 - 6 * re**2, 2 * np.ones(Ni)))

# Connectome Matrix / Synaptic Weights (S)
# Excitatory connections drive (+), inhibitory connections suppress (-)
S = np.hstack((0.5 * np.random.rand(N, Ne), -np.random.rand(N, Ni)))

# Initial state variables
v = -65 * np.ones(N)  # Initial membrane voltage (mV)
u = b * v             # Membrane recovery variable

# Array to store firing events (Spikes) for analysis
firings = []

# ==========================================
# 2. TIME-STEP SIMULATION LOOP (1,000 ms = 1 Second)
# ==========================================
sim_time = 1000  # milliseconds

for t in range(sim_time):
    # External stimulation current (Thalamus / Sensory Input)
    I = np.hstack((5 * np.random.randn(Ne), 2 * np.random.randn(Ni)))
    
    # Identify which neurons reached the firing threshold (>= 30 mV)
    fired = np.where(v >= 30)[0]
    
    if len(fired) > 0:
        # Record [time, neuron_ID]
        for f in fired:
            firings.append([t, f])
            
        # Post-spike reset
        v[fired] = c[fired]
        u[fired] = u[fired] + d[fired]
        
        # Propagation of impulses through the Connectome (S)
        I += np.sum(S[:, fired], axis=1)

    # Numerical Integration (Izhikevich Differential Equations - Euler's Method)
    v += 0.5 * (0.04 * v**2 + 5 * v + 140 - u + I)
    v += 0.5 * (0.04 * v**2 + 5 * v + 140 - u + I)  # Two-step numerical stability
    u += a * (b * v - u)

# Convert recorded firings to a NumPy array
firings = np.array(firings)

# ==========================================
# 3. NEUROSCIENCE VISUALIZATION (Raster Plot)
# ==========================================
plt.figure(figsize=(12, 6))

if len(firings) > 0:
    # Separate excitatory and inhibitory neurons by color
    excitatory_mask = firings[:, 1] < Ne
    
    plt.scatter(firings[excitatory_mask, 0], firings[excitatory_mask, 1], 
                s=1.5, c='crimson', label='Excitatory (800)')
    plt.scatter(firings[~excitatory_mask, 0], firings[~excitatory_mask, 1], 
                s=1.5, c='navy', label='Inhibitory (200)')

plt.title('Biological Neural Activity Simulation (Cortical Signature / Spikes)', fontsize=14)
plt.xlabel('Time (milliseconds)', fontsize=12)
plt.ylabel('Neuron ID (0 to 1000)', fontsize=12)
plt.xlim([0, sim_time])
plt.ylim([0, N])
plt.legend(loc='upper right')
plt.grid(True, alpha=0.3)
plt.show()
